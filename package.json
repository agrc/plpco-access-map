{
  "name": "plpco-videos",
  "version": "1.13.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:prod": "vite build --mode viewer_prod && vite build --mode internal_prod --outDir dist/internal --base /internal/ && vite build --mode bellwether_prod --outDir dist/bellwether --base /bellwether/",
    "build:stage": "vite build --mode viewer_stage && vite build --mode internal_stage --outDir dist/internal --base /internal/ && vite build --mode bellwether_stage --outDir dist/bellwether --base /bellwether/",
    "check": "tsc -b",
    "format": "prettier --write .",
    "lint": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "release": "standard-version",
    "start": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-packagejson"
    ],
    "printWidth": 120,
    "singleQuote": true
  },
  "dependencies": {
    "@arcgis/core": "^5.1.17",
    "@arcgis/map-components": "^5.1.17",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-hook/window-size": "^3.1.1",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "downshift": "^9.4.0",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.sortby": "^4.7.0",
    "lodash.uniqwith": "^4.5.0",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-fast-compare": "^3.2.2",
    "reactstrap": "^9.2.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-links": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@types/node": "^26.2.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "10.5.7",
    "firebase-tools": "^15.26.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prop-types": "^15.8.1",
    "sass": "^1.102.0",
    "storybook": "10.5.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
